{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "recovery-radar",
  "compatibility_date": "2026-09-01",
  "main": "./worker/index.ts",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "RECOVERY_STATE"
    }
  ],
  "triggers": {
    "crons": ["15 15 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
